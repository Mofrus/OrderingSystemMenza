@page "/menu-items"
@attribute [Authorize(Roles = "Admin")]
@inject HttpClient Http

<PageTitle>Správa denního menu</PageTitle>

<h1>Správa denního menu</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm">@errorMessage</div>
}

@if ((menuItems == null || meals == null) && string.IsNullOrEmpty(errorMessage))
{
    <p><em>Načítám...</em></p>
}
else if (menuItems == null || meals == null)
{
    <p></p>
}
else
{
    <button class="btn btn-primary mb-3" @onclick="ShowCreateForm">Přidat položku na menu</button>

    @if (isCreating || editingId != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">@(isCreating ? "Nová položka" : "Úprava položky")</h5>
                <EditForm Model="currentMenuItem" OnValidSubmit="SaveMenuItem">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label class="form-label">Datum</label>
                        <InputDate class="form-control" @bind-Value="currentMenuItem.Date" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Jídlo</label>
                        <InputSelect class="form-control" @bind-Value="currentMenuItem.MealId">
                            <option value="">Vyberte jídlo...</option>
                            @foreach (var meal in meals.Where(m => m.IsActive))
                            {
                                <option value="@meal.Id">@meal.Name (@meal.Price.ToString("C"))</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Počet porcí</label>
                        <InputNumber class="form-control" @bind-Value="currentMenuItem.AvailablePortions" />
                    </div>

                    <button type="submit" class="btn btn-success">Uložit</button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Zrušit</button>
                </EditForm>
            </div>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Jídlo</th>
                <th>Porce k dispozici</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in menuItems.OrderByDescending(m => m.Date))
            {
                <tr>
                    <td>@item.Date.ToShortDateString()</td>
                    <td>@item.MealName</td>
                    <td>@item.AvailablePortions</td>
                    <td>
                        <button class="btn btn-sm btn-primary" @onclick="() => EditMenuItem(item)">Upravit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteMenuItem(item.Id)">Odstranit</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<MenuItemDto>? menuItems;
    private List<MealDto>? meals;
    private bool isCreating = false;
    private Guid? editingId = null;
    private MenuItemFormModel currentMenuItem = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (AccessTokenNotAvailableException ex)
        {
            ex.Redirect();
        }
        catch (Exception ex)
        {
            errorMessage = $"Chyba při načítání: {ex.Message}";
        }
    }

    private async Task LoadData()
    {
        meals = await Http.GetFromJsonAsync<List<MealDto>>("meals");
        menuItems = await Http.GetFromJsonAsync<List<MenuItemDto>>("menu-items");
    }

    private void ShowCreateForm()
    {
        isCreating = true;
        editingId = null;
        currentMenuItem = new MenuItemFormModel { Date = DateOnly.FromDateTime(DateTime.Today) };
    }

    private void EditMenuItem(MenuItemDto item)
    {
        isCreating = false;
        editingId = item.Id;
        currentMenuItem = new MenuItemFormModel
        {
            Date = item.Date,
            MealId = item.MealId.ToString(),
            AvailablePortions = item.AvailablePortions
        };
    }

    private void CancelEdit()
    {
        isCreating = false;
        editingId = null;
    }

    private async Task SaveMenuItem()
    {
        if (!Guid.TryParse(currentMenuItem.MealId, out var mealId))
            return;

        if (isCreating)
        {
            var createDto = new CreateMenuItemDto
            {
                Date = currentMenuItem.Date,
                MealId = mealId,
                AvailablePortions = currentMenuItem.AvailablePortions
            };
            await Http.PostAsJsonAsync("menu-items", createDto);
        }
        else if (editingId.HasValue)
        {
            var updateDto = new UpdateMenuItemDto
            {
                Date = currentMenuItem.Date,
                MealId = mealId,
                AvailablePortions = currentMenuItem.AvailablePortions
            };
            await Http.PutAsJsonAsync($"menu-items/{editingId.Value}", updateDto);
        }

        CancelEdit();
        await LoadData();
    }

    private async Task DeleteMenuItem(Guid id)
    {
        await Http.DeleteAsync($"menu-items/{id}");
        await LoadData();
    }

    class MenuItemFormModel
    {
        public DateOnly Date { get; set; }
        public string MealId { get; set; } = string.Empty;
        public int AvailablePortions { get; set; }
    }
}