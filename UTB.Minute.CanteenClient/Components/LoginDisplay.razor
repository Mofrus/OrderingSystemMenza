@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<AuthorizeView>
    <Authorized>
        <span class="navbar-text me-3 text-white">
            <i class="bi bi-person-circle me-1"></i> @context.User.Identity?.Name
        </span>
        <button class="btn btn-outline-light btn-sm" @onclick="BeginSignOut">Odhlásit</button>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-in-right me-1"></i> Zaměstnanec</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    private void BeginSignOut()
    {
        Navigation.NavigateToLogout("authentication/logout");
    }
}