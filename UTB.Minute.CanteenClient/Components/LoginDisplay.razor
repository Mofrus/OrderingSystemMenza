@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<AuthorizeView>
    <Authorized>
        Přihlášen jako: @context.User.Identity?.Name!
        <button class="nav-link btn btn-link" @onclick="BeginSignOut">Odhlásit se</button>
    </Authorized>
    <NotAuthorized>
        <a href="authentication/login">Přihlásit se</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject]
    public NavigationManager Navigation { get; set; } = default!;

    [Inject]
    public SignOutSessionStateManager SignOutManager { get; set; } = default!;

    private async Task BeginSignOut()
    {
        await SignOutManager.SetSignOutState();
        Navigation.NavigateTo("authentication/logout");
    }
}