@page "/my-orders"
@using Blazored.LocalStorage
@implements IDisposable
@inject HttpClient Http
@inject SseNotificationService Sse
@inject ILocalStorageService LocalStorage

<PageTitle>Moje objednávky</PageTitle>

<h1>Moje objednávky</h1>

@if (orders == null)
{
    <p><em>Načítám...</em></p>
}
else if (orders.Count == 0)
{
    <div class="alert alert-info">Nemáte žádné aktivní objednávky. Pokud jste si právě objednali, ujistěte se, že máte povolené LocalStorage.</div>
}
else
{
    <table class="table table-hover shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Číslo objednávky</th>
                <th>Jídlo</th>
                <th>Datum</th>
                <th>Stav</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in orders)
            {
                <tr>
                    <td class="fw-bold text-primary">@order.Id.ToString()[..8].ToUpper()</td>
                    <td>@order.MenuItem.MealName</td>
                    <td>@order.MenuItem.Date.ToShortDateString()</td>
                    <td>
                        <span class="badge @GetStatusClass(order.Status) p-2">@order.Status</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<OrderDto>? orders;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Sse.OnNotificationReceived += HandleNotification;
        await LoadOrders();
        _ = Sse.StartListeningAsync();
    }

    private void HandleNotification()
    {
        InvokeAsync(async () =>
        {
            await LoadOrders();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Sse.OnNotificationReceived -= HandleNotification;
    }

    private async Task LoadOrders()
    {
        try 
        {
            var localIds = await LocalStorage.GetItemAsync<List<string>>("my_orders") ?? new List<string>();
            
            if (localIds.Count == 0)
            {
                orders = new List<OrderDto>();
                return;
            }

            // Build query string ?ids=...&ids=...
            var query = string.Join("&", localIds.Select(id => $"ids={id}"));
            orders = await Http.GetFromJsonAsync<List<OrderDto>>($"orders?{query}");
        }
        catch (Exception ex)
        {
            errorMessage = "Nepodařilo se načíst objednávky: " + ex.Message;
            orders = new List<OrderDto>(); // Stop spinning
        }
    }

    private string GetStatusClass(Contracts.Enums.OrderStatus status) => status switch
    {
        Contracts.Enums.OrderStatus.Preparing => "bg-warning text-dark",
        Contracts.Enums.OrderStatus.Ready => "bg-success shadow-sm",
        Contracts.Enums.OrderStatus.Cancelled => "bg-danger",
        Contracts.Enums.OrderStatus.Completed => "bg-secondary",
        _ => "bg-primary"
    };
}