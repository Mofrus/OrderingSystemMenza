@page "/"
@using Blazored.LocalStorage
@implements IDisposable
@inject HttpClient Http
@inject SseNotificationService Sse
@inject ILocalStorageService LocalStorage

<PageTitle>Jídelníček</PageTitle>

<h1 class="mb-4">Jídelníček</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger shadow-sm">@errorMessage</div>
}

@if (menuItems == null)
{
    @if (string.IsNullOrEmpty(errorMessage))
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Načítám...</span>
            </div>
            <p class="mt-2 text-muted">Načítám nabídku jídel...</p>
        </div>
    }
}
else
{
    <!-- Date Selector (Calendar / Week Tabs) -->
    <div class="d-flex mb-4 overflow-auto pb-2 border-bottom">
        @foreach (var date in availableDates)
        {
            var isSelected = date == selectedDate;
            <button class="btn @(isSelected ? "btn-primary shadow-sm" : "btn-outline-secondary") me-2 rounded-pill px-4" 
                    @onclick="() => SelectDate(date)">
                <div class="fw-bold">@date.ToString("ddd")</div>
                <div>@date.ToString("dd.MM.")</div>
            </button>
        }
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger shadow-sm">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success shadow-sm">@successMessage</div>
    }

    <!-- Vertical Meal List -->
    var currentDayItems = menuItems.Where(m => m.Date == selectedDate).ToList();

    if (currentDayItems.Count == 0)
    {
        <div class="alert alert-light border shadow-sm text-center py-4">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-2"></i>
            Pro tento den není naplánováno žádné menu.
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var item in currentDayItems)
            {
                <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3 @(item.AvailablePortions <= 0 ? "bg-light" : "")">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold fs-5 @(item.AvailablePortions <= 0 ? "text-muted text-decoration-line-through" : "text-dark")">
                            @item.MealName
                        </div>
                        <div class="text-muted small mt-1">
                            <i class="bi bi-pie-chart-fill me-1"></i> Zbývá porcí: @item.AvailablePortions
                        </div>
                    </div>
                    <div class="ms-4">
                        @if (item.AvailablePortions > 0)
                        {
                            <button class="btn btn-primary rounded-pill px-4 fw-bold" @onclick="() => OrderMeal(item.Id)">
                                Objednat
                            </button>
                        }
                        else
                        {
                            <span class="badge bg-danger p-2 rounded-pill fs-6">Vyprodáno</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    private List<MenuItemDto>? menuItems;
    private List<DateOnly> availableDates = new();
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        // Setup week dates (today + next 6 days)
        var today = DateOnly.FromDateTime(DateTime.Today);
        for (int i = 0; i < 7; i++)
        {
            availableDates.Add(today.AddDays(i));
        }

        Sse.OnNotificationReceived += HandleNotification;
        await LoadMenu();
        _ = Sse.StartListeningAsync();
    }

    private void SelectDate(DateOnly date)
    {
        selectedDate = date;
        errorMessage = null;
        successMessage = null;
    }

    private void HandleNotification()
    {
        InvokeAsync(async () =>
        {
            await LoadMenu();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Sse.OnNotificationReceived -= HandleNotification;
    }

    private async Task LoadMenu()
    {
        try 
        {
            menuItems = await Http.GetFromJsonAsync<List<MenuItemDto>>("menu-items");
        }
        catch (Exception ex)
        {
            errorMessage = "Nepodařilo se načíst menu: " + ex.Message;
        }
    }

    private async Task OrderMeal(Guid menuItemId)
    {
        errorMessage = null;
        successMessage = null;

        var dto = new CreateOrderDto { MenuItemId = menuItemId };
        var response = await Http.PostAsJsonAsync("orders", dto);

        if (response.IsSuccessStatusCode)
        {
            var order = await response.Content.ReadFromJsonAsync<OrderDto>();
            if (order != null)
            {
                await SaveOrderIdLocally(order.Id);
                successMessage = $"Jídlo bylo úspěšně objednáno. Vaše číslo: {order.Id.ToString()[..8].ToUpper()}";
            }
            await LoadMenu();
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            errorMessage = await response.Content.ReadAsStringAsync();
            await LoadMenu();
        }
        else
        {
            errorMessage = "Při objednávání došlo k chybě.";
        }
    }

    private async Task SaveOrderIdLocally(Guid orderId)
    {
        var orders = await LocalStorage.GetItemAsync<List<string>>("my_orders") ?? new List<string>();
        if (!orders.Contains(orderId.ToString()))
        {
            orders.Add(orderId.ToString());
            await LocalStorage.SetItemAsync("my_orders", orders);
        }
    }
}